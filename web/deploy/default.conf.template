# ghost.js8 web: static UI + same-origin proxy to the bridge. TLS terminates at
# your reverse proxy (NPM / Caddy); point it at this container's port 8080.
# Rendered by the nginx image entrypoint (envsubst) from GHOSTJS8_BRIDGE_UPSTREAM.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    # Resolve the bridge lazily so the UI still serves while it restarts.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $bridge http://${GHOSTJS8_BRIDGE_UPSTREAM};

    include /etc/nginx/snippets/security-headers.conf;
    # The UI only issues GETs and WebSocket upgrades; nothing large comes in.
    client_max_body_size 16k;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /ws {
        proxy_pass $bridge;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;  # keep the port: the bridge compares it with Origin
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /api/ {
        proxy_pass $bridge;
        proxy_set_header Host $http_host;  # keep the port: the bridge compares it with Origin
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /readyz {
        proxy_pass $bridge;
    }

    # Many nginx mime.types lack .mjs; module workers (MapLibre) refuse
    # application/octet-stream under nosniff.
    location ~* \.mjs$ {
        types { }
        default_type text/javascript;
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}
