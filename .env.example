# Copy to .env and adjust. No secrets are required for a default deployment.

# Public port the web container listens on (put your reverse proxy in front).
GHOSTJS8_HTTP_PORT=8080

# Origins allowed to open the browser WebSocket (comma-separated).
GHOSTJS8_ALLOWED_ORIGINS=https://ghost.example.net

# Number of decoder containers / concurrently decoded receivers.
GHOSTJS8_DECODER_SLOTS=1

# Minutes to keep a Kiwi connection with no browser attached. 0 = keep listening forever.
GHOSTJS8_IDLE_DISCONNECT_MINUTES=0

# Decode/station retention in the SQLite store.
GHOSTJS8_RETENTION_DAYS=30

# Limits
GHOSTJS8_MAX_CLIENTS_PER_SESSION=16
GHOSTJS8_WATERFALL_MAX_FPS=10

# Log level: DEBUG, INFO, WARNING, ERROR
GHOSTJS8_LOG_LEVEL=INFO
