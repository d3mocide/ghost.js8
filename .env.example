# Copy to .env and adjust. No secrets are required for a default deployment.

# Where the web container listens on the host. Keep 127.0.0.1 when a reverse
# proxy on the same host fronts it; use 0.0.0.0 only behind your own firewall.
GHOSTJS8_HTTP_BIND=127.0.0.1
GHOSTJS8_HTTP_PORT=8080

# Origins allowed to open the browser WebSocket (comma-separated). Empty = only
# same-origin pages (the Origin must match the Host your proxy forwards).
# Setting your public URL is still recommended.
GHOSTJS8_ALLOWED_ORIGINS=https://ghost.example.net

# Start listening at boot (persistent listening). Leave the host empty to pick a
# receiver from the UI instead.
GHOSTJS8_RECEIVER_HOST=
GHOSTJS8_RECEIVER_PORT=8073
GHOSTJS8_RECEIVER_PASSWORD=
GHOSTJS8_DIAL_HZ=14078000
GHOSTJS8_MODE=usb
GHOSTJS8_LOW_CUT_HZ=100
GHOSTJS8_HIGH_CUT_HZ=3000

# Minutes to keep the receiver with no browser watching. 0 = keep listening forever.
GHOSTJS8_IDLE_DISCONNECT_MINUTES=0

# Decode/station retention in the SQLite store.
GHOSTJS8_RETENTION_DAYS=30

# Limits
GHOSTJS8_MAX_CLIENTS_PER_SESSION=16
GHOSTJS8_WATERFALL_MAX_FPS=10

# Receivers chosen in the UI (or by the GhostNet autopilot) must resolve to public
# addresses. Set true to allow your own LAN KiwiSDR (private, CGNAT/tailnet
# ranges). Loopback, link-local and metadata addresses are always refused. A
# receiver you configure above (GHOSTJS8_RECEIVER_HOST) is trusted as-is.
GHOSTJS8_ALLOW_PRIVATE_RECEIVERS=false

# Use published multi-arch images (amd64/arm64) instead of building locally:
#   docker compose pull && docker compose up -d --no-build
# GHOSTJS8_IMAGE_PREFIX=ghcr.io/d3mocide/ghostjs8
# GHOSTJS8_TAG=0.1.0

# Logs: json (default) or text; level DEBUG/INFO/WARNING/ERROR
GHOSTJS8_LOG_FORMAT=json
GHOSTJS8_LOG_LEVEL=INFO

# GhostNet autopilot (docs/ghostnet.md): follow your region's GhostNet JS8 windows on
# the nearest public KiwiSDR and record them (traffic, waterfall, audio). Off by default.
GHOSTJS8_GHOSTNET=off
# Region: na | eu | aus. Home grid: your Maidenhead locator, e.g. EM73.
GHOSTJS8_GHOSTNET_REGION=na
GHOSTJS8_HOME_GRID=
# GHOSTJS8_GHOSTNET_PREROLL_MINUTES=10
# FLAC audio, roughly 35-50 MB per recorded hour:
# GHOSTJS8_GHOSTNET_RECORD_AUDIO=on
# Watch 7.107 MHz between windows (not recorded):
# GHOSTJS8_GHOSTNET_PARK=on
# GHOSTJS8_NET_RETENTION_DAYS=90

# Decoder placeholder identity (never transmitted; JS8Call refuses to start without one).
# Set on the decoder service if you want different values.
# GHOSTJS8_JS8_CALL=N0CALL
# GHOSTJS8_JS8_GRID=AA00

# Building behind a TLS-intercepting proxy: path to a full CA bundle.
# EXTRA_CA=/path/to/ca-bundle.crt
